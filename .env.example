# Mercado Livre — obtenha em afiliados.mercadolivre.com.br (painel "Gere seus links").
# São os parâmetros de rastreamento que ficam anexados a toda URL de produto.
ML_AFFILIATE_MATT_WORD="sova2623541"
ML_AFFILIATE_MATT_TOOL="81520161"

# Amazon Associates — seu ID de rastreamento (ex: "seusite-20").
# Se preenchido, é anexado automaticamente às URLs de produto da Amazon
# que você colar "limpas" em src/data/products.ts.
AMAZON_ASSOCIATE_TAG="caoseamor09-20"


# Shopee não tem parâmetro de afiliado padronizado: gere o link direto no
# app/portal do Shopee Afiliados e cole a URL completa em products.ts.
